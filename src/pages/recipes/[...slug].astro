---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Measure from '../../components/Measure.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes', ({ data }) => !data.draft);
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { yield: makes, ingredients } = recipe.data;

const BATCH_SIZES = [
  { factor: 0.5, label: '½×' },
  { factor: 1, label: '1×' },
  { factor: 2, label: '2×' },
  { factor: 3, label: '3×' },
];
---

<Layout title={recipe.data.title} description={recipe.data.description}>
  <article>
    <header class="blog-post-header">
      <h1>{recipe.data.title}</h1>
      {recipe.data.description && (
        <p style="color: var(--color-text-muted); margin-top: 0.5rem; font-size: 1rem;">
          {recipe.data.description}
        </p>
      )}
    </header>
    <hr />
    <section class="blog-post-body">
      <div class="batch-control" role="group" aria-label="Batch size" data-batch-control hidden>
        <span class="batch-control-label">Batch size</span>
        {BATCH_SIZES.map(({ factor, label }) => (
          <button
            type="button"
            class="batch-btn"
            data-factor={factor}
            aria-pressed={String(factor === 1)}
          >{label}</button>
        ))}
      </div>

      {makes && (
        <p>Makes <Measure qty={makes.qty} unit={makes.unit} /></p>
      )}

      <h2>Ingredients</h2>
      <ul>
        {ingredients.map(({ name, measures: [primary, ...alternates] }) => (
          <li>
            <Measure qty={primary.qty} unit={primary.unit} /> {name}{
              alternates.length > 0 && (
                <>{' ('}{alternates.map((alternate, i) => (
                  <>{i > 0 && ', '}<Measure qty={alternate.qty} unit={alternate.unit} /></>
                ))}{')'}</>
              )
            }
          </li>
        ))}
      </ul>

      <Content />
    </section>
  </article>

  <div style="margin-top: 3rem;">
    <a href="/recipes/" style="font-family: var(--font-sans); font-size: 0.875rem; font-weight: 600;">
      ← Recipes
    </a>
  </div>

  <script>
    import { formatMeasure } from '../../lib/recipe';

    const control = document.querySelector<HTMLElement>('[data-batch-control]');
    if (control) {
      const buttons = control.querySelectorAll<HTMLButtonElement>('[data-factor]');
      const measures = document.querySelectorAll<HTMLElement>('.measure[data-qty]');

      control.hidden = false;
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const factor = Number(button.dataset.factor);
          measures.forEach((el) => {
            el.textContent = formatMeasure(Number(el.dataset.qty) * factor, el.dataset.unit);
          });
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        });
      });
    }
  </script>
</Layout>
