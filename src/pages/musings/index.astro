---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const musings = (await getCollection('musings'))
  .sort((a, b) => (b.data.date ?? '').localeCompare(a.data.date ?? ''));
---

<Layout title="Musings">
  <header class="blog-post-header">
    <h1>Musings</h1>
    <p style="color: var(--color-text-muted); font-size: 1rem;">
      Notes on how I work and the tools I build along the way.
    </p>
  </header>
  <ul class="post-list">
    {musings.map((musing) => (
      <li class="post-list-item">
        <a href={`/musings/${musing.id}/`}>{musing.data.title}</a>
        {musing.data.draft && <span class="draft-label">Draft</span>}
        {musing.data.description && <p>{musing.data.description}</p>}
      </li>
    ))}
  </ul>
</Layout>
